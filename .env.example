# =====================================================================
# Local Government Agenda & Minutes Management System
# Copy to .env.local for development. Never commit a filled-in copy.
# =====================================================================

# ---------------------------------------------------------------------
# Browser-safe. These two values are compiled into client JavaScript and
# are expected to be visible. Security comes from Row-Level Security, not
# from hiding the anon key.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Canonical origin of this deployment. Used to build permanent document
# URLs, canonical tags, and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://records.example-city.gov

# Slug of the municipality this deployment serves by default. Multi-tenant
# deployments resolve the tenant per request instead and may leave this set
# to the primary tenant.
NEXT_PUBLIC_DEFAULT_MUNICIPALITY=city-of-example

# ---------------------------------------------------------------------
# Server only. Never prefix these with NEXT_PUBLIC_. Never import them
# from a file that also runs in the browser. The service role key bypasses
# every Row-Level Security policy in the database.
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Maximum accepted upload in megabytes. The database bucket enforces a hard
# 50 MB ceiling above whatever is set here.
MAX_UPLOAD_MB=25

# Requests per minute per IP against /api/public/*.
PUBLIC_API_RATE_LIMIT=120

# ---------------------------------------------------------------------
# Deployment secrets (set in the hosting provider, not in this file)
# ---------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN   - Supabase CLI token, used by CI to run migrations
# SUPABASE_DB_PASSWORD    - database password, used by `supabase db push` in CI
# SUPABASE_PROJECT_REF    - project reference for CI linking
